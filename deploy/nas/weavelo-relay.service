[Unit]
Description=Weavelo WebSocket Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nobody
Environment=WEAVELO_RELAY_BIND_ADDR=127.0.0.1:39493
Environment=WEAVELO_RELAY_WEBSOCKET=1
Environment=WEAVELO_RELAY_LOG=0
Environment=WEAVELO_RELAY_MAX_CONNECTIONS=128
Environment=WEAVELO_RELAY_MAX_PEERS_PER_GROUP=8
Environment=WEAVELO_RELAY_WRITER_QUEUE_CAPACITY=16
Environment=WEAVELO_RELAY_IDLE_TIMEOUT_SECONDS=30
ExecStart=/opt/weavelo-relay/weavelo-relay
Restart=always
RestartSec=1
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
