[Unit]
Description=RemotePlay P2P Rendezvous
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nobody
Environment=REMOTE_PLAY_P2P_RENDEZVOUS_BIND_ADDR=0.0.0.0:3478
Environment=REMOTE_PLAY_P2P_MAX_PEERS_PER_GROUP=16
Environment=REMOTE_PLAY_P2P_MAX_TOTAL_PEERS=4096
Environment=REMOTE_PLAY_P2P_RENDEZVOUS_LOG=0
ExecStart=/opt/remote-play-p2p/remote-play-p2p-rendezvous
Restart=always
RestartSec=1
LimitNOFILE=16384
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
